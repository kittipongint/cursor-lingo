#include <windows.h>
#include "resource.h"

IDI_APP ICON "../assets/AppIcon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "CursorLingo.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CursorLingo"
      VALUE "FileDescription", "CursorLingo - input language badge at the mouse pointer"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "CursorLingo"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "CursorLingo.exe"
      VALUE "ProductName", "CursorLingo"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
